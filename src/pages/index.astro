<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mona Mayhem</title>
		<script is:inline>
			try {
				if (localStorage.getItem('mona-mayhem-theme') === 'blue-orange') {
					document.documentElement.dataset.theme = 'blue-orange';
				}
			} catch {
				// Keep the default theme when browser storage is unavailable.
			}
		</script>
	</head>
	<body>
		<main>
			<div class="theme-control">
				<label for="theme-select">색상 테마</label>
				<select id="theme-select">
					<option value="classic">초록 / 보라 · 클래식</option>
					<option value="blue-orange">파랑 / 주황 · 아케이드</option>
				</select>
			</div>
			<header>
				<p class="eyebrow">GITHUB CONTRIBUTION BATTLE ARENA</p>
				<h1>Mona Mayhem</h1>
				<p>GitHub 기여도 배틀 아레나에 오신 것을 환영합니다!</p>
			</header>
		</main>
		<script>
			const themeSelect = document.querySelector<HTMLSelectElement>('#theme-select');
			if (themeSelect) {
				themeSelect.value = document.documentElement.dataset.theme === 'blue-orange'
					? 'blue-orange'
					: 'classic';
				themeSelect.addEventListener('change', () => {
					const theme = themeSelect.value === 'blue-orange' ? 'blue-orange' : 'classic';
					document.documentElement.dataset.theme = theme;
					try {
						localStorage.setItem('mona-mayhem-theme', theme);
					} catch {
						// Theme switching still works without browser storage.
					}
				});
			}
		</script>
	</body>
</html>

<style>
	:global(:root) {
		color-scheme: dark;
		--background: #0a0a1a;
		--surface: #151528;
		--text: #f4f4ff;
		--accent-primary: #5fed83;
		--accent-secondary: #8a2be2;
	}

	:global(:root[data-theme='blue-orange']) {
		--accent-primary: #00f5ff;
		--accent-secondary: #ff6b35;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		min-width: 20rem;
		min-height: 100vh;
		background: var(--background);
		color: var(--text);
		font-family: 'Courier New', monospace, system-ui;
		line-height: 1.6;
	}

	:global(body)::after {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		background: repeating-linear-gradient(
			transparent 0 3px,
			rgb(0 0 0 / 12%) 3px 4px
		);
	}

	main {
		max-width: 72rem;
		margin: auto;
		padding: clamp(1rem, 5vw, 4rem);
	}

	.theme-control {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 4rem;
	}

	select {
		max-width: 100%;
		padding: 0.75rem;
		border: 2px solid var(--accent-primary);
		border-radius: 0;
		background: var(--surface);
		color: var(--text);
		font: inherit;
		cursor: pointer;
		box-shadow: 4px 4px 0 var(--accent-secondary);
	}

	select:focus-visible {
		outline: 3px solid var(--text);
		outline-offset: 5px;
	}

	header {
		padding: clamp(1rem, 4vw, 3rem);
		border: 2px solid var(--accent-primary);
		border-bottom: 6px solid var(--accent-secondary);
		background: var(--surface);
		text-align: center;
		box-shadow: 8px 8px 0 var(--accent-secondary);
	}

	.eyebrow {
		color: var(--accent-primary);
		font-size: 0.85rem;
		letter-spacing: 0.12em;
		overflow-wrap: anywhere;
	}

	h1 {
		margin: 1rem 0;
		color: var(--accent-primary);
		font-size: clamp(2rem, 7vw, 5rem);
		line-height: 1.2;
		text-transform: uppercase;
		text-shadow: 3px 3px var(--accent-secondary);
	}
</style>
